{
  "model": "Qwen3.8-27B",
  "base_url_env": "SCI_QWEN_API_BASE",
  "api_key_env": "SCI_QWEN_API_KEY",
  "context_window": 262144,
  "max_output_tokens": 32000,
  "max_tokens_field": "max_tokens",
  "max_turns": 100,
  "max_seconds": 3600,
  "api_timeout_seconds": 300,
  "compaction": {
    "threshold": 200000,
    "keep": 12
  },
  "embedding": {
    "profile": "256",
    "backend": "cuda",
    "corpus_scale": "100k"
  },
  "python": "python3",
  "pricing": {
    "mode": "unpriced_self_hosted"
  },
  "thinking_level": "xhigh",
  "reasoning_effort": "xhigh",
  "compat": {
    "thinkingFormat": "qwen-chat-template",
    "supportsReasoningEffort": false
  },
  "rate_limit_retry": {
    "enabled": true,
    "min_delay_seconds": 1,
    "max_delay_seconds": 20,
    "max_attempts": 100,
    "max_elapsed_seconds": 900
  },
  "api": "openai-responses",
  "responses_system_role": "system",
  "minimum_request_interval_seconds": 5
}
