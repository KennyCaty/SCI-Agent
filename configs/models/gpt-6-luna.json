{
  "model": "gpt-6-luna",
  "base_url_env": "SCI_LUNA_API_BASE",
  "api_key_env": "SCI_LUNA_API_KEY",
  "context_window": 262144,
  "max_output_tokens": 32000,
  "max_turns": 100,
  "max_seconds": 3600,
  "api_timeout_seconds": 300,
  "compaction": {
    "threshold": 200000,
    "keep": 12
  },
  "embedding": {
    "profile": "256",
    "backend": "cuda",
    "corpus_scale": "100k"
  },
  "python": "python3",
  "pricing": {
    "currency": "USD",
    "source": "GPT-6 Luna Standard",
    "tiers": [
      {
        "up_to_input_tokens": 271999,
        "input": 0.1,
        "cache_read": 0.01,
        "cache_write": 0.125,
        "output": 0.5
      },
      {
        "input": 0.2,
        "cache_read": 0.02,
        "cache_write": 0.25,
        "output": 0.75
      }
    ]
  },
  "rate_limit_retry": {
    "enabled": true,
    "min_delay_seconds": 1,
    "max_delay_seconds": 20,
    "max_attempts": 100,
    "max_elapsed_seconds": 900
  },
  "api": "openai-responses",
  "minimum_request_interval_seconds": 5
}
